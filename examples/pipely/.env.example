# pipely — 前置配置模板
#
# omnigent 运行时**自身不解析这个文件**。必须由启动命令注入,例如:
#
#     uv run --env-file examples/pipely/.env omnigent serve
#
# 复制为 `.env` 后逐项填写。每一项都标注了用途、归属哪个 Agent、是否必需。
# 缺任一必需项时,前置校验会在派发第一个任务**之前**一次性列出全部缺失项并停止
# (omnigent/policies/pipely/preflight.py),不会跑到一半才失败。
#
# ── 为什么名字都带 OMNIGENT_ 前缀 ────────────────────────────────
# 运行时支持 `OMNIGENT_<NAME>` 前缀别名(omnigent/env_credentials.py),规范名优先。
# 加前缀是为了不和宿主机上同名的变量撞车——这台机器上很可能已经有一个
# 给别的工具用的 `GITHUB_TOKEN`。


# ══════════════════════════════════════════════════════════════════
# 一、模型访问
# ══════════════════════════════════════════════════════════════════

# 【必需】五个 Agent 全部使用。
OMNIGENT_DEEPSEEK_API_KEY=


# ══════════════════════════════════════════════════════════════════
# 二、代码托管(GitHub)
# ══════════════════════════════════════════════════════════════════

# 【必需】仅架构开发子 Agent。克隆、拉取、推送、开 PR。
#
# 权限:contents:write + pull_requests:write。
# **不要给 merge 权限** —— 合并由人执行(FR-045、FR-070)。
# 这条边界靠托管服务的令牌作用域强制,不靠提示词;A30 验证的就是它。
OMNIGENT_GIT_TOKEN=
OMNIGENT_GIT_USERNAME=

# 【可选】公共仓库匿名克隆时留空即可(FR-068、A31)。


# ══════════════════════════════════════════════════════════════════
# 三、OpenMetadata bot 令牌 —— 一个 Agent 一个,不共用
# ══════════════════════════════════════════════════════════════════
#
# 这四个令牌各自注入到对应子 Agent 的 MCP 声明里
# (agents/<name>/tools/mcp/openmetadata.yaml 的 headers)。
# 分开配置不是形式:合用一个令牌,任何一个 Agent 的越权都无从归因,
# 而 bot 自检(FR-074)也就没有可探测的边界了。

# 【必需】OpenMetadata 服务地址,五处 MCP 声明共用。
OMNIGENT_OM_BASE_URL=

# 【必需】引导用只读 bot。**由平台管理员手工创建**(FR-076)。
# Agent 缺它时必须报错停止,**不得尝试自建** —— 创建这个 bot 所需的权限,
# 正是它本身要引导出来的那个权限。
OMNIGENT_OM_BOOTSTRAP_READER=

# 【必需】治理审计子 Agent。只读。
# 自检时会对它做**写探测**,探测未被拒即判自检失败(FR-074、SC-025)。
OMNIGENT_OM_GOVERNANCE_READER=

# 【必需】架构开发子 Agent。
# 读:数据源与落地表的结构与归属。
# 写:**仅限沙箱 Domain**(FR-103)—— 中间表与结果表要真实落地,
#     但绝不落进受治理的正式资产空间。越界由 identity.check_write 拒绝(SC-038)。
OMNIGENT_OM_ARCHITECT=

# 【必需】运维发布子 Agent。**每条管线一个**,不是全局共用。
# 写:仅限本管线的资产(FR-105)。跨管线写入被拒(SC-040)。
# 多条管线时按 `OMNIGENT_OM_RELEASE__<PIPELINE>` 增配。
OMNIGENT_OM_RELEASE=

# 【必需】服务验证子 Agent。只读。
# 写入 / 建索引 / 切指向的尝试一律被拒(FR-035、A46)。
OMNIGENT_OM_CONSUMER=


# ══════════════════════════════════════════════════════════════════
# 四、调度器(OpenMetadata 自带的 Airflow)
# ══════════════════════════════════════════════════════════════════

# 【必需】仅运维发布子 Agent。触发、暂停、查询作业运行。
#
# **与目录写入分开配置**(FR-057)。调度器和目录同源部署,很容易让人以为
# 一个令牌该覆盖两者 —— 但"运行作业"不是"治理作业"。
# 用这个凭证发起平台级治理操作会被 identity.check_operation 拒绝(A42)。
OMNIGENT_AIRFLOW_BASE_URL=
OMNIGENT_AIRFLOW_TOKEN=


# ══════════════════════════════════════════════════════════════════
# 五、不属于本文件的东西
# ══════════════════════════════════════════════════════════════════
#
# ▸ 平台管理凭证(建 Domain、授角色、改策略)
#   **绝不出现在这里,也绝不出现在任何 Agent 的进程环境或工具配置中**
#   (FR-003、FR-063、SC-002)。
#   平台管理员直接对 OpenMetadata 操作,那条线绕开 omnigent。
#   架构开发子 Agent 有 shell,能读到整个进程环境 —— 因此"不放进来"是唯一
#   成立的边界,"放进来但不用它"不算。
#   identity.check_environment 会在这些变量名出现时拒绝启动(U32)。
#
# ▸ 会话共享与审批权委派
#   这两项**不是环境变量**,在 omnigent 的会话设置里配:
#     1. 把会话共享给平台管理员与运维负责人本人的账号;
#     2. 给他们委派 `can_approve`。
#   缺第 1 项报"闸门待办无法送达"(A8),缺第 2 项报另一种(A9) ——
#   两者分开报,因为处置方式不同。
#   `sys_session_share` 只能授予访问级别,**授不了审批权**;
#   审批权的唯一开关是编排者的 `agent_session_sharing`。
