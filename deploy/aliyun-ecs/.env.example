# Copy to .env ON THE ECS BOX and fill in. Never commit a filled-in copy —
# this repository is public. scripts/bootstrap.sh generates the two random
# secrets for you; the rest you paste in by hand.
#
# scripts/sync.sh excludes .env, so pushing config from your laptop can never
# overwrite what is on the box.

# ── Image ────────────────────────────────────────────────
# The ACR address CI pushes to. Whatever host you use here must be the one you
# `docker login` to — Docker stores credentials per hostname, and ACR's public
# and -vpc endpoints are different hostnames serving the same repository.
OMNIGENT_IMAGE=crpi-xxxxxxxxxxxx.cn-hangzhou.personal.cr.aliyuncs.com/<namespace>/omnigent-server
# `main` follows every push; a `sha-<short>` pin is immutable and reproducible.
# Prefer a sha pin while validating, so a background push cannot change what
# a restart brings up.
OMNIGENT_IMAGE_TAG=main

# Host port the server is published on. 8000 rather than 80/443 keeps this
# clear of Aliyun's ICP enforcement, which only polices those two.
OMNIGENT_PORT=8000

# ── Postgres ─────────────────────────────────────────────
# Generated by bootstrap.sh. Internal to the compose network, but a weak one
# is still a weak one.
POSTGRES_PASSWORD=

# ── Auth (accounts mode) ─────────────────────────────────
# Generated by bootstrap.sh. Signs session cookies — anyone holding it can
# forge a login as any user. Rotating it only forces everyone to sign in
# again; passwords are argon2 hashes in Postgres and are unaffected.
OMNIGENT_ACCOUNTS_COOKIE_SECRET=

# The URL your browser actually uses. Wrong value breaks invite links and
# cookie security decisions.
#   IP phase:     http://<ECS public IP>:8000
#   domain phase: https://<your domain>
OMNIGENT_ACCOUNTS_BASE_URL=http://<ECS public IP>:8000

# First admin's password. Username is `admin`. Set this BEFORE first boot:
# until a password-bearing account exists, the setup endpoint is open to
# whoever reaches it first.
OMNIGENT_ACCOUNTS_INIT_ADMIN_PASSWORD=

# ── Artifacts in OSS ─────────────────────────────────────
# Leave OMNIGENT_ARTIFACT_URI empty to keep artifacts on the local volume.
# Set it to switch to OSS; the other four are then required.
OMNIGENT_ARTIFACT_URI=s3://<bucket>/artifacts
# Internal endpoint from ECS — free and faster. Swap -internal out for local
# debugging from your laptop.
AWS_ENDPOINT_URL_S3=https://oss-cn-hangzhou-internal.aliyuncs.com
AWS_REGION=cn-hangzhou
# OSS only accepts bucket.<endpoint>/key. Leave this alone unless you move to
# a provider that wants <endpoint>/bucket/key (MinIO) or can take either
# (AWS, R2 — those work on "auto").
AWS_S3_ADDRESSING_STYLE=virtual
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Backups ──────────────────────────────────────────────
# Consumed by scripts/backup.sh and scripts/restore.sh, not by the server.
OSS_BUCKET=<bucket>
OSS_BACKUP_PREFIX=backup
# Objects older than this are pruned after each successful upload.
BACKUP_RETENTION_DAYS=30
